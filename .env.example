# Database Configuration (PostgreSQL 16)
POSTGRES_DB=pmc_property_tax
POSTGRES_USER=pmc_admin
POSTGRES_PASSWORD=PmcSecurePass2025!
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pmc_property_tax
SPRING_DATASOURCE_USERNAME=pmc_admin
SPRING_DATASOURCE_PASSWORD=PmcSecurePass2025!
SERVER_PORT=8085

# Security & Authentication (JWT Secret must be 256-bit or greater)
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_MS=86400000

# Payment Gateway Configuration (SBI ePay / UPI Integration)
PAYMENT_GATEWAY_PROVIDER=SBI_EPAY
PAYMENT_GATEWAY_MERCHANT_ID=PMC_MUNICIPAL_TAX_01
PAYMENT_GATEWAY_API_KEY=pmc_epay_test_key_live_2025
PAYMENT_GATEWAY_WEBHOOK_SECRET=pmc_sbi_epay_webhook_secret_key_2025
PAYMENT_UPI_VPA=pmc.tax@sbi

# Government Integration Mocking & Feature Flags
MOCK_IGR_MAHARASHTRA=true
MOCK_MAHARERA_API=true
MOCK_MHADA_PUNE_BOARD=true
ENABLE_3X_PENALTY_SCRUTINY=true

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api/v1
VITE_PORT=5173
